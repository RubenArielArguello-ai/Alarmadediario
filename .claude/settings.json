      "Bash(git remote:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh auth status:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run lint:*)",
